{"kind": "short", "title": "Where and When to See It", "segments": [{"start": 0.0, "end": 1.19, "label": "", "text": "Sound familiar?"}, {"start": 1.41, "end": 3.51, "label": "", "text": "You might think you need a telescope."}, {"start": 3.73, "end": 4.45, "label": "", "text": "Wrong."}, {"start": 4.67, "end": 6.7, "label": "", "text": "You just need a clear line of sight."}, {"start": 6.92, "end": 8.54, "label": "", "text": "Any altitude works."}, {"start": 8.76, "end": 11.06, "label": "", "text": "Even from sea level, you can see it."}, {"start": 11.28, "end": 13.95, "label": "", "text": "The key is an unobstructed horizon."}, {"start": 14.17, "end": 16.0, "label": "", "text": "Oceans are perfect for this."}, {"start": 16.22, "end": 18.53, "label": "", "text": "But that is not your only option."}, {"start": 18.75, "end": 20.43, "label": "", "text": "Cloud tops work too."}, {"start": 20.65, "end": 22.36, "label": "", "text": "So do mountain peaks."}, {"start": 22.58, "end": 25.23, "label": "", "text": "Does location change the duration?"}, {"start": 25.45, "end": 26.15, "label": "", "text": "Yes."}, {"start": 26.37, "end": 28.69, "label": "", "text": "At the equator, the flash is brief."}, {"start": 28.91, "end": 31.35, "label": "", "text": "It rarely lasts longer than a second."}, {"start": 31.57, "end": 33.25, "label": "", "text": "What about the sky above you?"}, {"start": 33.47, "end": 35.69, "label": "", "text": "Airline pilots spot this often."}, {"start": 35.91, "end": 37.34, "label": "", "text": "They fly westward."}, {"start": 37.56, "end": 39.44, "label": "", "text": "This slows down the sunset."}, {"start": 39.66, "end": 41.64, "label": "", "text": "They see the flash regularly."}, {"start": 41.86, "end": 43.53, "label": "", "text": "That extra time helps."}, {"start": 43.75, "end": 46.05, "label": "", "text": "The story starts with ink and paper."}], "video_id": "YDS7MyAZSqk"}