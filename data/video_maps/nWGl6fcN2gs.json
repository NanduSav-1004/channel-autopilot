{"kind": "short", "title": "Why the flash is green", "segments": [{"start": 0.0, "end": 2.18, "label": "", "text": "Why is the sunset flash green?"}, {"start": 2.4, "end": 5.3, "label": "", "text": "It is a meteorological optical phenomenon."}, {"start": 5.52, "end": 8.76, "label": "", "text": "A distinct green spot darts above the Sun\u2019s limb."}, {"start": 8.98, "end": 11.71, "label": "", "text": "The answer lies in Earth\u2019s atmosphere."}, {"start": 11.93, "end": 13.36, "label": "", "text": "It acts like a prism."}, {"start": 13.58, "end": 14.95, "label": "", "text": "It refracts sunlight."}, {"start": 15.17, "end": 17.7, "label": "", "text": "It pulls colors apart by wavelength."}, {"start": 17.92, "end": 19.29, "label": "", "text": "Why don\u2019t we see blue?"}, {"start": 19.51, "end": 21.75, "label": "", "text": "Blue light gets scattered out of sight."}, {"start": 21.97, "end": 24.68, "label": "", "text": "It leaves green as the last visible hue."}, {"start": 24.9, "end": 27.18, "label": "", "text": "The atmosphere strips away the blues."}, {"start": 27.4, "end": 29.58, "label": "", "text": "Green remains for that heartbeat."}, {"start": 29.8, "end": 31.72, "label": "", "text": "It\u2019s not a trick of the eye."}, {"start": 31.94, "end": 33.88, "label": "", "text": "It\u2019s physics at the horizon."}, {"start": 34.1, "end": 35.95, "label": "", "text": "The green flash is real."}], "video_id": "nWGl6fcN2gs"}